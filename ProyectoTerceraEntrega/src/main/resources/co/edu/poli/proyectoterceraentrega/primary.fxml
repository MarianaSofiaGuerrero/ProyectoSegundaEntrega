<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<VBox alignment="CENTER" spacing="12.0"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.poli.proyectoterceraentrega.PrimaryController"
      style="-fx-background-color: #f4f6f0;">
   <children>
      <Label text="GESTIÓN DE INSUMOS AGRÍCOLAS"
             style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2d5a1b;">
         <font><Font name="System Bold" size="20.0" /></font>
      </Label>
      <Separator prefWidth="340.0" />
      <Button fx:id="btnCrear" text="1.  Crear insumo"
              onAction="#irACrear" prefWidth="300.0"
              style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px;
                     -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20 10 20;" />
      <Button fx:id="btnBuscar" text="2.  Buscar insumo por ID"
              onAction="#irABuscar" prefWidth="300.0"
              style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 14px;
                     -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20 10 20;" />
      <Button fx:id="btnListar" text="3.  Listar todos los insumos"
              onAction="#irAListar" prefWidth="300.0"
              style="-fx-background-color: #009688; -fx-text-fill: white; -fx-font-size: 14px;
                     -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20 10 20;" />
      <Button fx:id="btnModificar" text="4.  Modificar insumo"
              onAction="#irAModificar" prefWidth="300.0"
              style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 14px;
                     -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20 10 20;" />
      <Button fx:id="btnEliminar" text="5.  Eliminar insumo"
              onAction="#irAEliminar" prefWidth="300.0"
              style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-font-size: 14px;
                     -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20 10 20;" />
      <Button fx:id="btnGuardar" text="6.  Guardar en archivo (.bin)"
              onAction="#guardarArchivo" prefWidth="300.0"
              style="-fx-background-color: #795548; -fx-text-fill: white; -fx-font-size: 14px;
                     -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20 10 20;" />
      <Separator prefWidth="340.0" />
      <Button fx:id="btnSalir" text="0.  Salir"
              onAction="#salir" prefWidth="300.0"
              style="-fx-background-color: #607D8B; -fx-text-fill: white; -fx-font-size: 14px;
                     -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20 10 20;" />
      <Label fx:id="lblEstado" text=""
             style="-fx-font-size: 12px; -fx-text-fill: #2d5a1b; -fx-font-style: italic;" />
   </children>
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
</VBox>